# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code agent worktrees — full repo copies created by background agents,
# typically hundreds of MB. Never commit these to source control.
.claude/worktrees/

# Claude Code runtime state — scheduled task locks, session caches. Should
# never be committed; the runtime regenerates these on demand.
.claude/scheduled_tasks.lock

# Stray Claude session worktrees that leaked outside .claude/worktrees/.
# Match the agent-suffix pattern (...-<5char-id>/) so we catch any future
# escapees without ignoring real project directories.
idea-synthesizer-claude-*/

# Personal MCP server config — points at the developer's own Supabase
# project ref. OAuth is per-user, so each contributor adds their own.
.mcp.json

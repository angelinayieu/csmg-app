NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database
POSTGRES_PASSWORD=interaxis_dev
DATABASE_URL=postgresql+asyncpg://interaxis:${POSTGRES_PASSWORD}@postgres:5432/interaxis
# Or for Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:${SUPABASE_DB_PASSWORD}@db.${SUPABASE_PROJECT_REF}.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# File Storage
S3_ENDPOINT=http://minio:9000
S3_BUCKET=interaxis-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=${MINIO_PASSWORD:-minioadmin}
# Or for production S3:
# S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
# S3_BUCKET=interaxis-uploads-prod

# AI Providers
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME
# Get from https://app.tavily.com/
TAVILY_API_KEY=tvly-REPLACE_ME

# tldraw production license. tldraw v3+ hides the canvas after 5
# seconds in production deployments unless a license is provided.
# Symptoms when missing: cards visible briefly, then canvas goes blank
# (display:none on tldraw root) while sidebar/chrome stays. Shapes are
# still in the store, the editor surface itself is just hidden.
# Get a key (free dev license available) at https://tldraw.dev/community/license
# Local dev on http://localhost normally bypasses the check, but having
# this wired protects every other deploy target.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=tldraw-REPLACE_ME

# Auth
CLERK_SECRET_KEY=sk_...
CLERK_PUBLISHABLE_KEY=pk_...
# Or for Supabase Auth:
# SUPABASE_URL=https://${SUPABASE_PROJECT_REF}.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Observability
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...

# Cost Controls
SESSION_COST_CEILING=5.00
DAILY_SPEND_ALERT=50.00

# Inngest (durable job queue)
# Not required for local dev — the Inngest CLI Dev Server auto-connects to /api/inngest.
# For production, create an Inngest account and paste the keys below.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Feature flag: route new analyses through the Inngest job queue instead of the
# legacy /api/orchestrate SSE route. Safe to toggle per environment.
NEXT_PUBLIC_USE_INNGEST=false
